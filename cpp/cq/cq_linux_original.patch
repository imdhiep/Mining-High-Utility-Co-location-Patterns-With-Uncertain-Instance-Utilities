 // Hash function for unordered_map
 std::size_t myHashFunc::operator()(const ObjWithoutCoord& inst) const
 {
-	std::size_t h1 = std::hash<char>()(inst.feature);
-	std::size_t h2 = std::hash<int>()(inst.instance);
+	// MSVC std::hash: FNV-1a over the bytes of the value (64-bit), as on the authors' Windows build
+	auto fnv = [](const unsigned char* p, std::size_t n) { std::size_t h = 14695981039346656037ULL;
+		for (std::size_t i = 0; i < n; ++i) { h ^= p[i]; h *= 1099511628211ULL; } return h; };
+	std::size_t h1 = fnv(reinterpret_cast<const unsigned char*>(&inst.feature), sizeof(inst.feature));
+	std::size_t h2 = fnv(reinterpret_cast<const unsigned char*>(&inst.instance), sizeof(inst.instance));
 	
 	return h1 ^ h2;
 }
