{
  "comment": "Running-time experiments of Section VI-C (claude/EXPERIMENT_DESIGN_UHUCPM.md, Part 4). Paths are relative to experiments/. PSO-MUCP datasets: the authors' repository (cloned into data/psomucp), utilities as in their code or mixed-sign as in the earlier checks.",
  "bin_dir": "../cpp/bin",
  "cq_binary": "../cpp/cq_build/total_fix/cq_hucpm",
  "layout_index": "data/layouts/index.json",
  "results_dir": "results",
  "reps": 5,
  "K": 100,
  "d": 50.0,
  "delta": 0.1,
  "z": 1.645,
  "experiments": {
    "C1_features": {"vary": "k", "values": [10, 20, 40, 60, 80],
                    "datasets": [{"kind": "synthetic", "name": "Synthetic", "n": 50000, "d": 50.0},
                                 {"kind": "layout", "name": "New_York", "d": 50.0}]},
    "C2_instances_synthetic": {"vary": "n", "values": [20000, 40000, 60000, 80000, 100000, 120000],
                               "datasets": [{"kind": "synthetic", "name": "Synthetic", "k": 20, "d": 50.0}]},
    "C2_instances_new_york": {"vary": "frac", "values": [0.25, 0.5, 0.75, 1.0],
                              "datasets": [{"kind": "layout", "name": "New_York", "k": 20, "d": 50.0}]},
    "C3_threshold": {"vary": "K", "values": [100, 300, 1000],
                     "datasets": [{"kind": "layout", "name": "New_Orleans", "k": 20, "d": 50.0},
                                  {"kind": "layout", "name": "Philadelphia", "k": 20, "d": 50.0},
                                  {"kind": "layout", "name": "New_York", "k": 20, "d": 50.0}]},
    "C4_las_vegas": {"vary": "d", "values": [100, 200, 300, 400],
                     "datasets": [{"kind": "psomucp", "name": "Las_Vegas", "file": "data/psomucp/DATA/LasVegas_POI 10f.csv",
                                   "utility": {"A": 2, "B": -2, "C": 4, "D": 5, "E": -3, "F": 5, "G": 6, "H": 9, "I": 9, "J": 10}},
                                  {"kind": "psomucp", "name": "Las_Vegas_checkins", "file": "data/psomucp/DATA/LasVegas_POI 10f.csv", "utility": null}]},
    "C4_toronto": {"vary": "d", "values": [100, 200, 300],
                   "datasets": [{"kind": "psomucp", "name": "Toronto", "file": "data/psomucp/DATA/Toronto_POI 16f.csv",
                                 "utility": {"A": 1, "B": 3, "C": -2, "D": 4, "F": 4, "G": 8, "I": -5, "J": 10, "K": 12, "L": 14, "M": 17, "N": 16, "O": 18, "P": 19}},
                                {"kind": "psomucp", "name": "Toronto_checkins", "file": "data/psomucp/DATA/Toronto_POI 16f.csv", "utility": null}]},
    "C4_california": {"vary": "d", "values": [500, 1000, 1500, 2000],
                      "datasets": [{"kind": "psomucp", "name": "California", "file": "data/psomucp/DATA/California_POI 13f.csv",
                                    "utility": {"A": 2, "B": 4, "C": 8, "D": 4, "E": 1, "F": 4, "G": 5, "H": 3, "I": 9, "J": 3, "K": 5, "L": 10, "M": 8}},
                                   {"kind": "psomucp", "name": "California_checkins", "file": "data/psomucp/DATA/California_POI 13f.csv", "utility": null}]}
  }
}
