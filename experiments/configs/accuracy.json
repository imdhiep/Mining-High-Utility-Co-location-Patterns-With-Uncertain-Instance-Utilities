{
  "comment": "Accuracy experiments of Section VI-B (claude/EXPERIMENT_DESIGN_UHUCPM.md, Part 4). Paths are relative to experiments/.",
  "bin_dir": "../cpp/bin",
  "cq_binary": "../cpp/cq_build/total_fix/cq_hucpm",
  "layout_index": "data/layouts/index.json",
  "results_dir": "results",
  "seeds": 20,
  "z": 1.645,
  "bootstrap": 20,
  "defaults": {"Ks": [100], "delta": 0.1, "deltas": [0.05, 0.1, 0.2], "d": 50.0, "k": 20, "frac": 1.0, "c": 1.0, "sd": 1.0,
               "law": "lognormal", "phi": 0.0, "ell": 0.0, "t": 0},
  "experiments": {
    "B1_evidence":     {"layouts": ["Philadelphia", "Tampa", "New_York", "Tokyo"], "vary": "c", "values": [0.5, 1, 2, 4, 8], "extras": true},
    "B1_pr":           {"layouts": ["New_York", "Tokyo"], "vary": "c", "values": [1]},
    "B2_overdispersion": {"layouts": ["Tampa", "New_York"], "vary": "phi", "values": [0.0, 0.5, 1.0, 2.0]},
    "B2_law":          {"layouts": ["Tampa", "New_York"], "vary": "law", "values": ["gamma", "mixture"]},
    "B2_spatial":      {"layouts": ["Tampa", "New_York"], "vary": "ell", "values": [200.0, 500.0]},
    "B2_truncation":   {"layouts": ["Tampa", "New_York"], "vary": "t", "values": [1]},
    "B3_threshold":    {"layouts": ["Philadelphia", "New_York"], "vary": "Ks", "values": [[100, 300, 1000]],
                        "set": {"deltas": [0.01, 0.05, 0.1, 0.2, 0.3]}},
    "B3_distance":     {"layouts": ["New_Orleans"], "vary": "d", "values": [30.0, 50.0, 70.0]},
    "B3_features":     {"layouts": ["New_York"], "vary": "k", "values": [10, 20, 30, 40]},
    "B3_share":        {"layouts": ["New_York"], "vary": "frac", "values": [0.25, 0.5, 0.75, 1.0]}
  }
}
